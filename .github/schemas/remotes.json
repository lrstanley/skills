{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lrstanley/skills/.github/schemas/remotes.json",
  "title": "Remote skill sync configuration",
  "type": "object",
  "required": ["remotes"],
  "additionalProperties": false,
  "properties": {
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "git_url", "commit_sha", "file_includes"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "git_url": {
            "type": "string",
            "format": "uri"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.github/patches/[a-z0-9._-]+\\.patch$"
            }
          },
          "file_includes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["src", "dest"],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "dest": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "file_excludes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["src"],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
